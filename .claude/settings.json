{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(PYTHONPATH=src nohup .venv/bin/python scripts/rebuild_index.py)",
      "Bash(echo \"rebuild started \\(PID $!\\) — ~26 min for 14,112 chunks\")",
      "Read(//private/tmp/**)",
      "Bash(python3 -)",
      "Bash(git check-ignore *)",
      "Bash(nohup bash -c 'set -a && . ./.env && set +a && PYTHONPATH=src .venv/bin/python scripts/rebuild_index.py')",
      "Bash(echo \"rebuild restarted PID $!\")",
      "Bash(~/.local/bin/uv add *)",
      "Bash(.venv/bin/python -c ' *)"
    ]
  }
}
